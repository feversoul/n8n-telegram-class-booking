# Token of your bot, from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# The public https address of this n8n, as Telegram will reach it (your domain
# or a tunnel). Telegram only delivers to https on ports 443, 80, 88 or 8443.
WEBHOOK_URL=https://bot.example.com/

STUDIO_NAME=My Studio
# A tz database name: Europe/Berlin, America/New_York, Asia/Singapore ...
STUDIO_TIMEZONE=Europe/Berlin

# Pick your own values; keep N8N_ENCRYPTION_KEY, it protects the stored credentials.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Port n8n listens on, on this machine.
N8N_PORT=5678
